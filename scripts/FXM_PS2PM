#!/bin/sh
# CUPS runs filters with a restricted PATH that omits Homebrew/MacPorts on macOS.
PATH="$PATH:/opt/homebrew/bin:/usr/local/bin:/opt/local/bin:/usr/bin"
export PATH

GS_BIN="$(command -v gs 2>/dev/null || true)"
if [ -z "$GS_BIN" ] || [ ! -x "$GS_BIN" ]; then
    echo "ERROR: FXM_PS2PM: Ghostscript (gs) not found in PATH ($PATH)" >&2
    exit 127
fi

GS_FONTPATH="$CUPS_FONTPATH"
export GS_FONTPATH

gsopts="-dQUIET -dDEBUG -dNOSAFER -dNOPAUSE -dBATCH"
gsopts="$gsopts -dNOMEDIAATTRS -sDEVICE=ppmraw -sstdout=%stderr"

# Render at the resolution FXM_PM2FXR assumes (from the FXOutputMode PPD
# option, default 600x600). Without -r, Ghostscript rasterizes at 72dpi and
# the output prints ~8x smaller, since FXM_PM2FXR only crops oversized
# input and never scales up undersized input.
resolution="600"
profile=""
set -f
for option in $5; do
    case $option in
        FXOutputMode=300x300) resolution="300" ;;
        FXOutputMode=*) resolution="600" ;;
        profile=*) profile="-scupsProfile=${option#profile=}" ;;
    esac
done
set +f
gsopts="$gsopts -r$resolution"

if [ -z "$6" ]; then
    exec "$GS_BIN" $gsopts -sOUTPUTFILE="%stdout" ${profile:+"$profile"} -
else
    exec "$GS_BIN" $gsopts -sOUTPUTFILE="%stdout" ${profile:+"$profile"} - < "$6"
fi
